# Copy to .env at the repository root. Every variable is optional except the
# API key, which triage, chat, and the smoke test all need.

# Anthropic API key used by the backend.
ANTHROPIC_API_KEY=

# Model overrides. Leave blank to use the defaults in backend/app/config.py.
ANTHROPIC_TRIAGE_MODEL=
ANTHROPIC_CHAT_MODEL=
# Model for the standalone smoke test (python -m app.ai.client).
ANTHROPIC_MODEL=

# SQLite file. Relative paths are resolved from the repository root.
DATABASE_PATH=backend/issuepilot.db

# Backend port the Vite dev server proxies /api to.
BACKEND_PORT=8000
